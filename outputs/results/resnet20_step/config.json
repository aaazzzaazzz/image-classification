{
  "name": "resnet20_step_es_main",
  "seed": 42,
  "data": {
    "root": ".",
    "val_size": 5000,
    "batch_size": 128,
    "num_workers": 4,
    "aug": "basic",
    "cutout": 0,
    "randaug_num_ops": 2,
    "randaug_magnitude": 9,
    "limit_train": 0,
    "limit_val": 0,
    "limit_test": 0
  },
  "model": {
    "name": "resnet20",
